<Window x:Class="WinOptimizer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinOptimizer" Width="1000" Height="780" MinWidth="720" MinHeight="520"
        WindowStartupLocation="CenterScreen" Background="{StaticResource Bg}"
        FontFamily="{StaticResource Mono}" FontSize="13" Foreground="{StaticResource Text}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
  <Grid>
    <Rectangle Fill="{StaticResource Scanlines}" IsHitTestVisible="False"/>
    <Grid Margin="24,20,24,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,14">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="ExportBtn" Content="Save report" Style="{StaticResource BtnGhost}" IsEnabled="False" Click="Export_Click" Margin="0,0,8,0"/>
                <Button x:Name="ScanBtn" Content="Scan this PC" Style="{StaticResource Btn}" Click="Scan_Click"/>
            </StackPanel>
            <StackPanel>
                <TextBlock FontSize="24" FontWeight="Bold" Foreground="{StaticResource Accent}">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="#39FF88" BlurRadius="14" ShadowDepth="0" Opacity="0.55"/>
                    </TextBlock.Effect>
                    <Run Text="&gt; WinOptimizer"/><Run Text="&#x2588;"/>
                </TextBlock>
                <TextBlock Text="// read-only recon for Windows 10 and 11. It tells you what to change; it never changes anything itself."
                           Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
            </StackPanel>
        </DockPanel>

        <!-- Standard-user notice -->
        <Border x:Name="AdminBanner" Grid.Row="1" Background="{StaticResource Warn}" CornerRadius="8" Padding="12,8" Margin="0,0,0,12">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Relaunch as administrator" Style="{StaticResource BtnGhost}" Padding="12,4"
                        FontWeight="Normal" Click="Elevate_Click"/>
                <TextBlock Foreground="{StaticResource WarnText}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0"
                           Text="Running as a standard user. The scan works, but boot timing and unused-program detection are more accurate as administrator. Still read-only either way."/>
            </DockPanel>
        </Border>

        <!-- System summary -->
        <ItemsControl x:Name="SummaryItems" Grid.Row="2" Margin="-5,0,-5,8" Visibility="Collapsed">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="3"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Background="{StaticResource Card}" BorderBrush="{StaticResource Line}" BorderThickness="1"
                            CornerRadius="3" Padding="12,9" Margin="5">
                        <StackPanel>
                            <TextBlock Text="{Binding Key}" Foreground="{StaticResource Muted}" FontSize="11"/>
                            <TextBlock Text="{Binding Value}" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip="{Binding Value}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Filters -->
        <StackPanel x:Name="FilterPanel" Grid.Row="3" Visibility="Collapsed" Margin="0,4,0,2">
            <ListBox x:Name="CategoryList" Style="{StaticResource PillList}" SelectionChanged="Filter_Changed"/>
            <DockPanel Margin="0,2,0,0">
                <TextBlock Text="Sort" Foreground="{StaticResource Muted}" VerticalAlignment="Top" Margin="0,5,10,0"/>
                <TextBlock x:Name="CountText" DockPanel.Dock="Right" Foreground="{StaticResource Muted}" VerticalAlignment="Top" Margin="10,5,0,0"/>
                <ListBox x:Name="SortList" Style="{StaticResource PillList}" SelectionChanged="Filter_Changed"/>
            </DockPanel>
        </StackPanel>

        <!-- Recommendations -->
        <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,4,-8,0" Padding="0,0,8,0">
            <ItemsControl x:Name="Cards">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource Card}" BorderBrush="{StaticResource Line}" BorderThickness="1"
                                CornerRadius="3" Padding="16,14" Margin="0,0,0,10">
                            <StackPanel>
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                                        <Border Background="{Binding DifficultyBg}" CornerRadius="3" Padding="9,2" Margin="6,0,0,0">
                                            <TextBlock Text="{Binding DifficultyText}" Foreground="{Binding DifficultyFg}" FontSize="11.5"/>
                                        </Border>
                                        <Border Background="{Binding ImpactBg}" CornerRadius="3" Padding="9,2" Margin="6,0,0,0">
                                            <TextBlock Text="{Binding ImpactText}" Foreground="{Binding ImpactFg}" FontSize="11.5"/>
                                        </Border>
                                        <Border Background="{Binding RiskBg}" CornerRadius="3" Padding="9,2" Margin="6,0,0,0">
                                            <TextBlock Text="{Binding RiskText}" Foreground="{Binding RiskFg}" FontSize="11.5"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding CategoryTag}" Foreground="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center"/>
                                </DockPanel>
                                <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource Accent}" TextWrapping="Wrap" Margin="0,6,0,4"/>
                                <TextBlock Text="{Binding Finding}" TextWrapping="Wrap"/>
                                <ItemsControl ItemsSource="{Binding BulletItems}" Margin="4,4,0,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="2"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" ToolTip="{Binding}" Margin="0,2,12,2"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button Content="{Binding OpenLabel}" Tag="{Binding Open}" Click="Open_Click" HorizontalAlignment="Left"
                                        Margin="0,10,0,0" Padding="12,5" FontWeight="Normal"
                                        ToolTip="Opens the Windows page where this change is made. WinOptimizer changes nothing itself.">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource BtnGhost}">
                                            <Setter Property="Foreground" Value="{StaticResource Accent}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Open}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Expander Header="Why, where and how" Margin="0,8,0,0" Foreground="{StaticResource Accent}">
                                    <StackPanel Margin="2,8,0,0" TextElement.Foreground="{StaticResource Text}">
                                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,8">
                                            <Run FontWeight="SemiBold" Text="Why: "/><Run Text="{Binding Why, Mode=OneWay}"/>
                                        </TextBlock>
                                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,8">
                                            <Run FontWeight="SemiBold" Text="Where: "/><Run Text="{Binding Where, Mode=OneWay}"/>
                                        </TextBlock>
                                        <TextBlock Text="Walkthrough" FontWeight="SemiBold" Margin="0,0,0,2"/>
                                        <ItemsControl ItemsSource="{Binding NumberedSteps}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="8,2,0,2"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock TextWrapping="Wrap" Margin="0,8,0,0">
                                            <Run FontWeight="SemiBold" Text="If it goes wrong: "/><Run Text="{Binding RiskNote, Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </Expander>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Idle / progress message -->
        <StackPanel x:Name="StatusPanel" Grid.Row="4" VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock x:Name="StatusText" FontSize="15" Foreground="{StaticResource Accent}" TextAlignment="Left" TextWrapping="Wrap"
                       Text="&gt; Press 'Scan this PC' to begin. Nothing will be changed."/>
            <ProgressBar x:Name="Progress" IsIndeterminate="False" Height="4" Width="260" Margin="0,14,0,0" Visibility="Collapsed"
                         Foreground="{StaticResource Accent}" Background="{StaticResource Line}" BorderThickness="0"/>
        </StackPanel>

        <!-- Footer -->
        <TextBlock Grid.Row="5" Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,10,0,0">
            Threat scale: No damage threat, Low, Moderate, High, Could cripple Windows. Use at your own risk; the author is not liable for any damage.
            Free for non-commercial use with a link back to
            <Hyperlink Foreground="{StaticResource Accent}" NavigateUri="https://github.com/nbwillcox/windowsOptimizer2026" RequestNavigate="Link_Navigate">github.com/nbwillcox/windowsOptimizer2026</Hyperlink>.
        </TextBlock>
    </Grid>
  </Grid>
</Window>
